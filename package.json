{
  "name": "daily-bot",
  "version": "1.0.0",
  "description": "Telegram Daily News & Event Bot on Cloudflare Workers",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute daily-bot-db --file=schema.sql --local",
    "db:apply:remote": "wrangler d1 execute daily-bot-db --file=schema.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
